# Copy to .env and fill in real values. Never commit .env.
# Used by docker-compose.yml to configure the db, server, and client containers.

# Port on your host machine to reach the web app (http://localhost:<this>)
CLIENT_PORT=8080

# MySQL
DB_ROOT_PASSWORD=change-me-root
DB_USER=feederisland
DB_PASSWORD=change-me
DB_NAME=feederisland

# Long, random, unique per deployment (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string

# Must match how you access the app in the browser, including port
# (same-origin via the client's nginx proxy) — used for CORS + cookies.
FRONTEND_ORIGIN=http://localhost:8080

# Only needed for the AI Insights feature. Kept server-side only.
ANTHROPIC_API_KEY=
# Claude model used by AI Insights. Leave blank for the default (claude-sonnet-4-6).
# AI Insights runs a tool loop (engine tools on the server, up to 8 rounds, 8000 output tokens per
# turn) and sends adaptive thinking to models that support it (Claude 4.6 and later).
ANTHROPIC_MODEL=

# Set to "true" once this sits behind HTTPS in production.
COOKIE_SECURE=false
