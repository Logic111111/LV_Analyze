# Copy to .env and fill in real values. Never commit .env.

PORT=4000
NODE_ENV=production

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=feederisland
DB_PASSWORD=change-me
DB_NAME=feederisland

# Long, random, unique per deployment (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string

# Where the React app is served from — used for CORS + cookie SameSite decisions
FRONTEND_ORIGIN=http://localhost:5173

# Only needed for the AI Insights feature. Kept server-side only — never sent to the browser.
ANTHROPIC_API_KEY=
# Claude model used by AI Insights. Leave blank for the default (claude-sonnet-4-6).
# Note: newer models (e.g. claude-sonnet-5-5, claude-opus-5-5) always think before answering, and
# thinking counts against the endpoint's max_tokens (1000) — check the brief isn't cut short
# before switching.
ANTHROPIC_MODEL=

# Set to "true" if the server sits behind HTTPS (reverse proxy/load balancer) in production,
# so auth cookies get the Secure flag. Leave false for local http development.
COOKIE_SECURE=false
