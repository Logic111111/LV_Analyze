# Copy to .env and fill in real values. Never commit .env.

PORT=4000
NODE_ENV=production

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=feederisland
DB_PASSWORD=change-me
DB_NAME=feederisland

# Long, random, unique per deployment (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string

# Where the React app is served from — used for CORS + cookie SameSite decisions
FRONTEND_ORIGIN=http://localhost:5173

# Only needed for the AI Insights feature. Kept server-side only — never sent to the browser.
ANTHROPIC_API_KEY=

# Set to "true" if the server sits behind HTTPS (reverse proxy/load balancer) in production,
# so auth cookies get the Secure flag. Leave false for local http development.
COOKIE_SECURE=false
