{
  // Type-checks the pure engine (JSDoc + // @ts-check). ES libs only — no DOM — so a browser API
  // used inside the engine is a type error, the same purity rule ESLint enforces on imports.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "types": [],
    "strict": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "@feeder-island/engine": ["../packages/engine/index.js"] }
  },
  // The engine package (P7.1) and the client's re-export of it.
  "include": ["../packages/engine/**/*.js", "src/lib/loadflow.js"]
}
